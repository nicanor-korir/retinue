# Context Intelligence Configuration Template
# Copy this file to .env and configure for your environment

# ============================================================================
# Context Intelligence Feature Flags
# ============================================================================

# Enable/disable context intelligence features
CONTEXT_INTELLIGENCE_ENABLED=true

# Enable quick context extraction on message creation
CONTEXT_QUICK_EXTRACTION_ENABLED=true

# Enable deep context extraction in background worker
CONTEXT_DEEP_EXTRACTION_ENABLED=true

# Enable dynamic prompt building with context
CONTEXT_DYNAMIC_PROMPTS_ENABLED=true

# Enable user activity tracking
CONTEXT_ACTIVITY_TRACKING_ENABLED=true

# ============================================================================
# Performance Settings
# ============================================================================

# Maximum time for quick context extraction (milliseconds)
CONTEXT_QUICK_EXTRACTION_TIMEOUT_MS=50

# Maximum time for deep context extraction (milliseconds)
CONTEXT_DEEP_EXTRACTION_TIMEOUT_MS=5000

# Context cache TTL (seconds)
CONTEXT_CACHE_TTL=3600

# Maximum context cache size (number of entries)
CONTEXT_CACHE_MAX_SIZE=1000

# ============================================================================
# Entity Extraction Settings
# ============================================================================

# Enable project entity extraction
CONTEXT_EXTRACT_PROJECTS=true

# Enable task entity extraction
CONTEXT_EXTRACT_TASKS=true

# Enable agent entity extraction
CONTEXT_EXTRACT_AGENTS=true

# Maximum entities to extract per message
CONTEXT_MAX_ENTITIES_PER_TYPE=10

# ============================================================================
# Intent Classification Settings
# ============================================================================

# Enable intent classification
CONTEXT_INTENT_CLASSIFICATION_ENABLED=true

# Intent classification confidence threshold (0.0 - 1.0)
CONTEXT_INTENT_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# Semantic Analysis Settings
# ============================================================================

# Enable semantic analysis
CONTEXT_SEMANTIC_ANALYSIS_ENABLED=true

# Maximum length for semantic summary (characters)
CONTEXT_SEMANTIC_SUMMARY_MAX_LENGTH=200

# Enable key phrase extraction
CONTEXT_EXTRACT_KEY_PHRASES=true

# Maximum key phrases to extract
CONTEXT_MAX_KEY_PHRASES=5

# ============================================================================
# Dynamic Prompt Settings
# ============================================================================

# Maximum prompt length (tokens)
CONTEXT_MAX_PROMPT_TOKENS=2000

# Include business context in prompts
CONTEXT_PROMPT_INCLUDE_BUSINESS=true

# Include conversation context in prompts
CONTEXT_PROMPT_INCLUDE_CONVERSATION=true

# Include historical context (from RAG) in prompts
CONTEXT_PROMPT_INCLUDE_HISTORICAL=true

# Number of historical contexts to retrieve
CONTEXT_PROMPT_HISTORICAL_LIMIT=3

# ============================================================================
# User Activity Tracking Settings
# ============================================================================

# Activity log retention period (days)
CONTEXT_ACTIVITY_RETENTION_DAYS=90

# Enable activity aggregation
CONTEXT_ACTIVITY_AGGREGATION_ENABLED=true

# Activity aggregation interval (minutes)
CONTEXT_ACTIVITY_AGGREGATION_INTERVAL=15

# Maximum activities to store per user
CONTEXT_ACTIVITY_MAX_PER_USER=1000

# Enable user preference learning
CONTEXT_ACTIVITY_LEARN_PREFERENCES=true

# ============================================================================
# Background Worker Settings
# ============================================================================

# Number of context enrichment workers
CONTEXT_WORKER_CONCURRENCY=4

# Worker queue max size
CONTEXT_WORKER_QUEUE_MAX_SIZE=1000

# Worker batch size for processing
CONTEXT_WORKER_BATCH_SIZE=10

# Worker retry attempts on failure
CONTEXT_WORKER_MAX_RETRIES=3

# Worker retry delay (seconds)
CONTEXT_WORKER_RETRY_DELAY=5

# ============================================================================
# RAG Integration Settings
# ============================================================================

# Enable RAG integration for context
CONTEXT_RAG_ENABLED=true

# RAG retrieval top-k results
CONTEXT_RAG_TOP_K=3

# RAG similarity threshold
CONTEXT_RAG_SIMILARITY_THRESHOLD=0.7

# Enable conversation indexing to RAG
CONTEXT_RAG_INDEX_CONVERSATIONS=true

# Enable user activity indexing to RAG
CONTEXT_RAG_INDEX_ACTIVITIES=true

# RAG indexing delay (seconds) - wait before indexing new messages
CONTEXT_RAG_INDEXING_DELAY=5

# ============================================================================
# Business Knowledge Settings
# ============================================================================

# Enable business knowledge integration
CONTEXT_BUSINESS_KNOWLEDGE_ENABLED=true

# Business knowledge cache TTL (seconds)
CONTEXT_BUSINESS_KNOWLEDGE_CACHE_TTL=7200

# Maximum business knowledge results to retrieve
CONTEXT_BUSINESS_KNOWLEDGE_MAX_RESULTS=5

# Auto-update business knowledge from completed tasks
CONTEXT_BUSINESS_KNOWLEDGE_AUTO_UPDATE=false

# ============================================================================
# Event System Settings
# ============================================================================

# Event bus backend for context intelligence (memory, redis)
CONTEXT_EVENT_BUS_BACKEND=memory

# Redis URL for event bus (if using redis backend)
# CONTEXT_EVENT_BUS_REDIS_URL=redis://localhost:6379

# Event delivery timeout (milliseconds)
CONTEXT_EVENT_DELIVERY_TIMEOUT_MS=5000

# Event queue max size
CONTEXT_EVENT_QUEUE_MAX_SIZE=10000

# ============================================================================
# Logging and Monitoring Settings
# ============================================================================

# Log level for context intelligence (DEBUG, INFO, WARNING, ERROR)
CONTEXT_LOG_LEVEL=INFO

# Enable performance metrics logging
CONTEXT_METRICS_ENABLED=true

# Metrics collection interval (seconds)
CONTEXT_METRICS_INTERVAL=60

# Log context extraction results
CONTEXT_LOG_EXTRACTION_RESULTS=false

# Log prompt building results
CONTEXT_LOG_PROMPT_BUILDING=false

# ============================================================================
# Development and Testing Settings
# ============================================================================

# Enable debug mode
CONTEXT_DEBUG_MODE=false

# Enable verbose logging
CONTEXT_VERBOSE_LOGGING=false

# Skip context extraction for test messages
CONTEXT_SKIP_TEST_MESSAGES=true

# Mock external services in testing
CONTEXT_MOCK_SERVICES=false

# ============================================================================
# Privacy and Security Settings
# ============================================================================

# Anonymize user data in activity logs
CONTEXT_ANONYMIZE_USER_DATA=false

# Maximum message content length to store in activity logs
CONTEXT_ACTIVITY_MAX_CONTENT_LENGTH=100

# Enable data retention enforcement
CONTEXT_DATA_RETENTION_ENFORCEMENT=true

# Encrypt sensitive context data
CONTEXT_ENCRYPT_SENSITIVE_DATA=false

# ============================================================================
# Feature-Specific Toggles
# ============================================================================

# Enable entity validation against database
CONTEXT_VALIDATE_ENTITIES=true

# Enable relationship mapping
CONTEXT_MAP_RELATIONSHIPS=true

# Enable conversation context aggregation
CONTEXT_AGGREGATE_CONVERSATION=true

# Enable proactive context suggestions
CONTEXT_PROACTIVE_SUGGESTIONS=false

# ============================================================================
# Experimental Features (Use with caution)
# ============================================================================

# Enable advanced NLP models for entity extraction
CONTEXT_EXPERIMENTAL_NLP=false

# Enable sentiment analysis
CONTEXT_EXPERIMENTAL_SENTIMENT=false

# Enable topic modeling
CONTEXT_EXPERIMENTAL_TOPICS=false

# Enable context prediction
CONTEXT_EXPERIMENTAL_PREDICTION=false
