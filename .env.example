# Database Configuration
DB_PASSWORD=your_secure_password_here

# LLM API Keys (REQUIRED)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security (change in production)
JWT_SECRET=your-jwt-secret-key-change-in-production

# Optional: Error Tracking
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Redis (default values work with docker-compose)
REDIS_URL=redis://localhost:6379

# Database URL (default values work with docker-compose)
# DATABASE_URL=postgresql+asyncpg://agent:your_password@localhost:5432/ai_company
