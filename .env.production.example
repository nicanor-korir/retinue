# Production Environment Variables Template
# Copy this to .env.production and fill in your values

# ===== DATABASE =====
DATABASE_URL=postgresql+asyncpg://agent:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/ai_company
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD

# ===== REDIS =====
REDIS_URL=redis://YOUR_REDIS_HOST:6379

# ===== AI/LLM =====
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ===== BACKEND =====
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Agent Configuration
AGENT_CHECK_INTERVAL=900  # 15 minutes
AGENT_INACTIVE_WARNING_THRESHOLD=1800  # 30 minutes
AGENT_INACTIVE_CRITICAL_THRESHOLD=7200  # 2 hours

# ===== FRONTEND =====
NEXT_PUBLIC_API_URL=https://your-backend-domain.com

# ===== SECURITY =====
SECRET_KEY=YOUR_RANDOM_SECRET_KEY_HERE
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-backend-domain.com

# ===== MONITORING (Optional) =====
SENTRY_DSN=  # For error tracking
LOG_LEVEL=INFO

# ===== RATE LIMITING (Optional) =====
RATE_LIMIT_PER_MINUTE=60
