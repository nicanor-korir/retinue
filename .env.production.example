# Retinue — production environment template (shared VPS topology)
#
#   cp .env.production.example .env.production
#   # fill in every CHANGE_ME
#   docker compose -f docker-compose.prod.yml --env-file .env.production pull
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Never commit .env.production — it is already covered by .gitignore.

# ===== DOMAINS =====
# Used to derive CORS_ORIGINS. Both need DNS records pointing at this server.
# NOTE: the frontend's copy of these is baked into its image at BUILD time by CI
# (repository variables NEXT_PUBLIC_API_URL / NEXT_PUBLIC_WS_URL). Changing them
# here alone is not enough — CI must rebuild the frontend image.
DOMAIN=retinue.nicanor.xyz
API_DOMAIN=api.retinue.nicanor.xyz

# ===== IMAGES =====
# Published by .github/workflows/ci-cd.yml. Lowercase the owner/repo — GHCR
# rejects uppercase. Pin to a specific tag for reproducible rollbacks.
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/YOUR_REPO/backend:latest
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/YOUR_REPO/frontend:latest

# ===== DATABASE (your existing PostgreSQL) =====
# Retinue does NOT run its own Postgres — see deploy/postgres-setup.sql for the
# database and role to create first.
#
# Postgres installed on the HOST:
DATABASE_URL=postgresql+asyncpg://retinue:CHANGE_ME_DB_PASSWORD@host.docker.internal:5432/retinue
#
# Postgres running as a CONTAINER — use its container name and attach it to the
# same network (add that network under `networks:` in docker-compose.prod.yml):
# DATABASE_URL=postgresql+asyncpg://retinue:CHANGE_ME_DB_PASSWORD@postgres:5432/retinue

# ===== REVERSE PROXY =====
# The external docker network your existing Caddy is attached to.
PROXY_NETWORK=proxy

# ===== AI / LLM =====
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
# Optional — only needed for embedding-based RAG features
OPENAI_API_KEY=

# ===== SECURITY =====
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARS

# ===== LOGGING =====
LOG_LEVEL=INFO
